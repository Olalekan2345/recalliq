# ─────────────────────────────────────────────────────────────────────────────
# RecallIQ configuration. Copy to `.env` (local) or set in your host's secret
# manager. Never commit real values. Server-side only unless prefixed
# NEXT_PUBLIC_. Every integration reports "not configured" honestly when its
# keys are missing — nothing is ever simulated.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# PostgreSQL 15+. Local: `pnpm dev:db` prints a ready URL.
DATABASE_URL=
DATABASE_POOL_MAX=10
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=
# Public URL of this deployment (also used to reach the x402 specialist endpoint).
NEXT_PUBLIC_APP_URL=http://localhost:3300
GUEST_ACCESS_ENABLED=true
LOG_LEVEL=info

# ── Background worker ────────────────────────────────────────────────────────
# inline     = worker runs inside the web process (single long-running service)
# external   = run `pnpm worker` as a separate service
# serverless = no worker; requests run queued jobs after their response (Vercel)
WORKER_MODE=inline
WORKER_CONCURRENCY=3
# serverless only: authorises Vercel Cron and drain hand-offs to /api/jobs/drain (any long random string)
CRON_SECRET=

# ── Language model (Vercel AI SDK) ───────────────────────────────────────────
# anthropic | openai | groq | google. Only Anthropic has a pinned default model
# (claude-opus-5-5) and a verified price table; for other providers set LLM_MODEL
# (and optionally prices, otherwise model cost is shown as "unknown").
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Generic override used for whichever provider is selected.
LLM_API_KEY=
LLM_PRICE_INPUT_USD_PER_MTOK=
LLM_PRICE_OUTPUT_USD_PER_MTOK=

# ── Tatum (Sui Mainnet gRPC) ─────────────────────────────────────────────────
# Get a key at https://dashboard.tatum.io/rpc-nodes/sui. Without it the keyless
# gateway works but rate-limits (HTTP 429) after a few calls.
TATUM_API_KEY=
TATUM_SUI_GRPC_URL=sui-mainnet-grpc.gateway.tatum.io:443
TATUM_TIMEOUT_MS=20000
# Requests per second your Tatum plan allows (free plan: 3). Calls are paced under it.
TATUM_MAX_RPS=3
SUI_NETWORK=mainnet
# Optional, disclosed fallback used ONLY for methods Tatum reports UNIMPLEMENTED.
SUI_FALLBACK_GRPC_URL=

# ── Walrus Memory (MemWal) ───────────────────────────────────────────────────
# Create an account + delegate key at https://memory.walrus.xyz
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE_PREFIX=recalliq
# Cosine-distance cutoff for recalled lessons (lower = stricter).
MEMWAL_RECALL_MAX_DISTANCE=0.72
MEMWAL_MAX_WRITES_PER_RUN=4

# ── x402 agent payments on Sui ───────────────────────────────────────────────
X402_NETWORK=sui:mainnet
# self   = RecallIQ verifies & settles via Tatum TransactionExecutionService
# remote = POST /verify and /settle on X402_FACILITATOR_URL (x402 v2 facilitator API)
X402_FACILITATOR_MODE=self
X402_FACILITATOR_URL=
# Your Sui address that receives specialist-API payments, and the allowlist.
X402_PAY_TO=
X402_ALLOWED_RECIPIENTS=
X402_PAYMENT_ASSET=0x2::sui::SUI
# Price per specialist call in atomic units of the asset (e.g. 10000000 = 0.01 SUI).
X402_FORENSICS_PRICE_ATOMIC=
X402_MAX_TIMEOUT_SECONDS=300
# Platform-wide hard caps (atomic units). Users can set tighter limits in Settings.
PAYMENT_MAX_PER_TX_ATOMIC=100000000
PAYMENT_MAX_PER_DAY_ATOMIC=500000000

# ── Agent limits ─────────────────────────────────────────────────────────────
AGENT_MAX_TOOL_CALLS=14
AGENT_MAX_ITERATIONS=12
AGENT_MAX_DURATION_MS=240000
AGENT_MAX_OUTPUT_TOKENS=8000
AGENT_MAX_CONCURRENT_RUNS_PER_USER=2
AGENT_MAX_RUNS_PER_HOUR_PER_USER=30
GUEST_MAX_RUNS_PER_DAY=5
