{
  "name": "recalliq",
  "version": "0.1.0",
  "private": true,
  "description": "RecallIQ — an evidence-driven Sui investigation agent that learns from verified mistakes (Walrus Memory) and pays for specialist analysis only when it is worth it (x402 on Sui, verified through Tatum).",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3300",
    "dev:db": "tsx scripts/local-db.ts",
    "build": "next build",
    "start": "next start",
    "start:local": "next start --port 3300",
    "worker": "tsx src/server/jobs/worker-main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\" \"*.mjs\"",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:live": "vitest run --project live",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "health": "tsx scripts/health.ts",
    "walrus:restore": "tsx scripts/walrus-restore.ts",
    "tools:sync": "tsx scripts/sync-tools.ts",
    "brand:assets": "tsx scripts/brand-assets.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.73",
    "@ai-sdk/google": "4.0.89",
    "@ai-sdk/groq": "4.0.56",
    "@ai-sdk/openai": "4.0.85",
    "@grpc/grpc-js": "1.13.6",
    "@mysten-incubation/memwal": "0.1.8",
    "@mysten/dapp-kit-core": "1.6.37",
    "@mysten/dapp-kit-react": "2.1.39",
    "@mysten/seal": "1.4.19",
    "@mysten/sui": "2.37.0",
    "@mysten/walrus": "1.2.34",
    "@protobuf-ts/grpc-transport": "2.11.1",
    "@protobuf-ts/runtime": "2.11.1",
    "@protobuf-ts/runtime-rpc": "2.11.1",
    "@tanstack/react-query": "5.104.1",
    "ai": "7.0.129",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.23",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "dotenv": "17.2.3",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "protobufjs",
      "embedded-postgres",
      "@embedded-postgres/windows-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64"
    ]
  }
}
